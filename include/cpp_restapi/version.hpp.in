#ifndef CPP_RESTAPI_VERSION_HPP
#define CPP_RESTAPI_VERSION_HPP

#include "cpp_restapi_export.h"

#define CPP_RESTAPI_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define CPP_RESTAPI_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define CPP_RESTAPI_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define CPP_RESTAPI_VERSION "@PROJECT_VERSION@"

// Feature macros: set to 1 when the corresponding optional component
// was enabled at build time, 0 otherwise. Public headers belonging to
// an optional component check these to fail with a readable diagnostic
// when included against a library that was built without the feature.
#cmakedefine01 CPP_RESTAPI_HAS_JSON_PAGINATION
#cmakedefine01 CPP_RESTAPI_HAS_GITHUB

namespace cpp_restapi
{
    inline constexpr int versionMajor = @PROJECT_VERSION_MAJOR@;
    inline constexpr int versionMinor = @PROJECT_VERSION_MINOR@;
    inline constexpr int versionPatch = @PROJECT_VERSION_PATCH@;
    inline constexpr char version[]   = "@PROJECT_VERSION@";

    /**
     * @brief Returns the version string of the linked cpp_restapi library.
     *
     * Unlike the compile-time @ref version constant (which reflects the
     * headers the consumer was built against), this function returns the
     * version baked into the actually-linked shared library, allowing
     * detection of header/library mismatch after an in-place upgrade.
     */
    CPP_RESTAPI_EXPORT const char* runtimeVersion() noexcept;
}

#endif
